# Copy to .env and fill in. Build-time values are also set on Netlify per environment.
#
# The site builds and runs without these. Supabase-backed parts stay quiet rather than
# failing, so a fork or first clone works before anybody has been given keys.
# See supabase/README.md for where each value comes from.

# Safe to expose. Ships in the browser bundle by design.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Public browser endpoint for the .NET Drip signup. The Hookdeck source must allow
# browser CORS requests from every deployed site origin.
PUBLIC_HOOKDECK_WEBHOOK_URL=

# The v2 project ref, for pnpm types. Not defaulted because the old ref still serves the
# live site and regenerating against it would quietly empty the generated types.
SUPABASE_PROJECT_REF=

# Never expose. Bypasses row level security completely. Used only during the static build.
SUPABASE_SERVICE_ROLE_KEY=

# Used once, after a data load, if the badge matcher is to key on stable Twitch ids
# rather than on logins. Not needed at build time or runtime. See docs/backfill.md.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
