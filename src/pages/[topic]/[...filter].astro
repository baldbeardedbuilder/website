---
import Base from '../../layouts/Base.astro';
import FeedItem from '../../components/FeedItem.astro';
import { TOPICS, topicBySlug } from '../../config/site';
import { itemKindLabel, itemsInTopic } from '../../lib/content';

export async function getStaticPaths() {
  return TOPICS.flatMap((topic) => [
    { params: { topic: topic.slug, filter: undefined } },
    { params: { topic: topic.slug, filter: 'articles' } },
    { params: { topic: topic.slug, filter: 'videos' } }
  ]);
}

const slug = String(Astro.params.topic ?? '');
const filter = String(Astro.params.filter ?? '');
const topic = topicBySlug(slug)!;
const all = await itemsInTopic(slug);
const items = all.filter((item) => {
  if (filter === 'articles') return item.kind === 'article';
  if (filter === 'videos') return item.kind === 'video' || item.kind === 'short';
  return true;
});
const title = filter === 'articles'
  ? `${topic.title} articles`
  : filter === 'videos'
    ? `${topic.title} videos`
    : topic.title;
const description = filter
  ? `${itemKindLabel(filter === 'articles' ? 'article' : 'video')}s about ${topic.title}.`
  : topic.blurb;
---

<Base title={title} description={description} active="topics" noindex={filter !== ''}>
  <main id="main" class="subpage">
    <section class="page-hero topic-stage">
      <div class="page-ghost" aria-hidden="true">{topic.title.toUpperCase()}.</div>
      <div class="page-hero-grid">
        <div>
          <span class="signal-label">Topic / {items.length} {items.length === 1 ? 'piece' : 'pieces'}</span>
          <h1>{title}</h1>
        </div>
        <div class="page-intro">
          <p>{topic.blurb}</p>
          <nav class="filter-nav" aria-label={`${topic.title} content filters`}>
            <a href={`/${slug}/`} aria-current={filter === '' ? 'page' : undefined}>Everything</a>
            <a href={`/${slug}/articles/`} aria-current={filter === 'articles' ? 'page' : undefined}>Articles</a>
            <a href={`/${slug}/videos/`} aria-current={filter === 'videos' ? 'page' : undefined}>Videos</a>
          </nav>
        </div>
      </div>
    </section>
    <section class="archive topic-archive">
      <header class="archive-head">
        <h2>{filter ? title : `Everything about ${topic.title}.`}</h2>
        <p>Newest first. No clever sorting hiding the good stuff.</p>
      </header>
      {items.length === 0
        ? <div class="empty-state"><h2>Nothing here yet.</h2><p>I have not published anything in this slice of the topic.</p></div>
        : <div class="archive-list">{items.map((item) => <FeedItem item={item} />)}</div>}
      <a class="section-link" href="/topics/">Browse every topic <span>&rarr;</span></a>
    </section>
  </main>
</Base>
