---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FeedItem from '../../components/FeedItem.astro';
import VideoEmbed from '../../components/VideoEmbed.astro';
import LikeButton from '../../components/islands/LikeButton';
import ShareMenu from '../../components/ShareMenu.astro';
import { topicBySlug } from '../../config/site';
import { isVideoKind, itemKindLabel, pagedItems, type Item } from '../../lib/content';
import { bakedLike } from '../../lib/likes';
import { assignContentSocialImages } from '../../lib/social-images';
import { videoTranscripts } from '../../lib/video-transcripts';

export async function getStaticPaths() {
  const [items, blog] = await Promise.all([pagedItems(), getCollection('blog')]);
  const posts = new Map(blog.map((post) => [post.id, post]));
  const socialImages = assignContentSocialImages(
    items.map((item) => ({
      key: item.key,
      title: item.title,
      topics: [item.topic, ...item.alsoFiled].map((slug) => {
        const topic = topicBySlug(slug);
        if (!topic) throw new Error(`No configured topic for "${slug}" on ${item.key}.`);
        return topic.title;
      })
    }))
  );

  return items.map((item) => {
    const socialImage = socialImages.get(item.key);
    if (!socialImage) throw new Error(`No social image generated for ${item.key}.`);

    return {
      params: { topic: item.topic, slug: item.slug },
      props: {
        item,
        socialImage,
        post: item.kind === 'article' ? posts.get(item.key.slice(5)) : undefined
      }
    };
  });
}

type Post = Awaited<ReturnType<typeof getCollection<'blog'>>>[number];
const { item, post, socialImage } = Astro.props as { item: Item; post?: Post; socialImage: string };
const pageUrl = item.url!;
const topic = topicBySlug(item.topic)!;
const Content = post ? (await render(post)).Content : null;
const video = isVideoKind(item.kind);

const dateLabel = item.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric'
});
const alsoFiled = item.alsoFiled.map((slug) => topicBySlug(slug)).filter(Boolean);
const transcript = video ? (await videoTranscripts()).get(item.key.slice(7)) : undefined;
const related = (await pagedItems())
  .filter((candidate) => candidate.key !== item.key && (
    candidate.topic === item.topic ||
    candidate.alsoFiled.includes(item.topic) ||
    item.alsoFiled.includes(candidate.topic)
  ))
  .slice(0, 3);

function timestamp(seconds: number): string {
  const whole = Math.floor(seconds);
  const hours = Math.floor(whole / 3600);
  const minutes = Math.floor((whole % 3600) / 60);
  const remainder = whole % 60;
  return hours
    ? `${hours}:${String(minutes).padStart(2, '0')}:${String(remainder).padStart(2, '0')}`
    : `${minutes}:${String(remainder).padStart(2, '0')}`;
}

function videoAt(href: string, seconds: number): string {
  const url = new URL(href);
  url.searchParams.set('t', `${Math.floor(seconds)}s`);
  return url.toString();
}

const transcriptHint = transcript
  ? transcript.topicCount
    ? `${transcript.topicCount} ${transcript.topicCount === 1 ? 'topic' : 'topics'}`
    : `${transcript.paragraphCount} paragraphs`
  : '';
const likes = await bakedLike('content', item.key);
---

<Base
  title={item.title}
  description={item.description || `${itemKindLabel(item.kind)} about ${topic.title}.`}
  active={video ? 'videos' : 'articles'}
  image={socialImage}
  noindex={item.draft}
  canonical={post?.data.canonicalUrl}
>
  <main
    id="main"
    class:list={['detail-page', { 'video-detail': video }]}
    data-pagefind-body
    data-pagefind-meta={`kind:${item.kind}`}
    data-pagefind-filter={`topic:${item.topic}`}
  >
    <header class="story-head" data-pagefind-filter={`kind:${item.kind}`}>
      <span class="story-topic" aria-hidden="true">{topic.title}</span>
      <div class="story-head-inner">
        <h1>{item.title}</h1>
        {item.description && <p class="lede">{item.description}</p>}
        <div class="story-byline">
          <time datetime={item.date.toISOString()}>{dateLabel}</time>
          <span>{item.length}</span>
        </div>
      </div>
    </header>
    <div class="detail-shell">
      <aside class="detail-rail" aria-label="About this piece">
        <dl>
          <div><dt>Topic</dt><dd><a href={`/${topic.slug}/`}>{topic.title}</a></dd></div>
          <div><dt>Published</dt><dd><time datetime={item.date.toISOString()}>{dateLabel}</time></dd></div>
          <div><dt>{video ? 'Run time' : 'Read time'}</dt><dd>{item.length}</dd></div>
          {item.views !== null && <div><dt>Views</dt><dd>{item.views.toLocaleString('en-US')}</dd></div>}
          {alsoFiled.length > 0 && (
            <div>
              <dt>Also filed</dt>
              <dd>{alsoFiled.map((filed) => <a href={`/${filed!.slug}/`}>{filed!.title}</a>)}</dd>
            </div>
          )}
        </dl>
        <div class="rail-acts">
          <LikeButton
            client:visible
            kind="content"
            targetKey={item.key}
            initial={likes}
            label="this piece"
          />
          <ShareMenu path={pageUrl} title={item.title} kind="content" targetKey={item.key} />
        </div>
      </aside>

      <article class="story">
        {video && item.external && (
          <div class="story-video">
            <VideoEmbed id={item.key.slice(7)} title={item.title} href={item.external} />
          </div>
        )}

        {Content && <div class="prose"><Content /></div>}

        {transcript && (
          <details class="transcript">
            <summary>Transcript <span class="hint">{transcriptHint}</span></summary>
            <div class="tbody">
              {transcript.chapters.map((chapter) => (
                <section class="tchapter">
                  {chapter.title && (
                    <header class="tchapter-head">
                      <h2>{chapter.title}</h2>
                      {chapter.start !== null && (
                        <a
                          class="t"
                          href={videoAt(item.external!, chapter.start)}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`Watch ${chapter.title} on YouTube at ${timestamp(chapter.start)}`}
                        >
                          {timestamp(chapter.start)}
                        </a>
                      )}
                    </header>
                  )}
                  <div class="tblocks">
                    {chapter.blocks.map((block) => (
                      <div class="tline">
                        {!transcript.soloSpeaker && block.speakerChanged && (
                          <div class="tmeta"><span class="speaker">{block.speaker}</span></div>
                        )}
                        <p>{block.text}</p>
                      </div>
                    ))}
                  </div>
                </section>
              ))}
            </div>
          </details>
        )}

        {video && (
          <p class="watch-youtube">
            <a class="button primary" href={item.external!} target="_blank" rel="noopener noreferrer">
              Watch on YouTube
            </a>
          </p>
        )}
      </article>
    </div>

    {related.length > 0 && (
      <section class="related-content">
        <header class="section-header">
          <span>Keep going</span>
          <h2>Related pieces.</h2>
          <p>More from the same corner of the workbench.</p>
        </header>
        <div class="archive-list">{related.map((candidate) => <FeedItem item={candidate} />)}</div>
      </section>
    )}
  </main>
</Base>
