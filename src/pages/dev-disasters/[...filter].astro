---
/*
  The dev disasters archive.

  Severity and sort are prerendered URLs, not client side controls. The mockup drew them
  as chips over a list, and a chip that only filters what has already loaded is exactly
  the bug decision 39 exists to kill. Real URLs are linkable, work with scripting off,
  and cost nothing at fifteen combinations.

  Paths this route owns:
    /dev-disasters/                    all, most liked
    /dev-disasters/[severity]/         one severity, most liked
    /dev-disasters/[severity]/[sort]/  one severity, one sort
  Every one of those segments is reserved so no disaster slug can shadow it.
*/
import Teller from '../../components/Teller.astro';
import Base from '../../layouts/Base.astro';
import Drip from '../../components/Drip.astro';
import { SEVERITIES, DISASTER_SORTS, sevClass, sevLabel, wqClass, type SeverityId } from '../../config/site';
import {
  allDisasters,
  sortDisasters,
  countsBySeverity,
  disasterCode,
  type DisasterSort
} from '../../lib/disasters';

export function getStaticPaths() {
  const scopes = ['all', ...SEVERITIES.map((s) => s.id)];
  const paths = [];

  for (const scope of scopes) {
    for (const sort of DISASTER_SORTS) {
      /*
        The default view is /dev-disasters/ rather than /dev-disasters/all/liked/, and a
        severity on its own means most liked. Anything else spells both segments out, so
        each view has exactly one URL and there is nothing to canonicalise.
      */
      const segments =
        scope === 'all' && sort.id === 'liked'
          ? undefined
          : scope === 'all'
            ? `all/${sort.id}`
            : sort.id === 'liked'
              ? scope
              : `${scope}/${sort.id}`;

      paths.push({ params: { filter: segments }, props: { scope, sort: sort.id } });
    }
  }

  return paths;
}

interface Props {
  scope: SeverityId | 'all';
  sort: DisasterSort;
}

const { scope, sort } = Astro.props;

const counts = countsBySeverity();
const all = allDisasters();
const rows = sortDisasters(
  scope === 'all' ? all : all.filter((d) => d.severity === scope),
  sort
);

/** Rebuilds a URL for this route from a scope and a sort, using the same rules as above. */
const viewUrl = (s: string, o: string) => {
  if (s === 'all' && o === 'liked') return '/dev-disasters/';
  if (s === 'all') return `/dev-disasters/all/${o}/`;
  if (o === 'liked') return `/dev-disasters/${s}/`;
  return `/dev-disasters/${s}/${o}/`;
};

const scopeLabel = scope === 'all' ? '' : sevLabel(scope);
const title = scope === 'all' ? 'dev disasters' : `${scopeLabel} dev disasters`;
const visibleSorts = DISASTER_SORTS.filter((option) => option.id !== 'replies');

/*
  The empty wall, worded for the view it is on.

  "Nothing filed under Error yet" needs a noun, and on the all scope scopeLabel is the
  empty string, so this read "Nothing filed under  yet" with a hole in it. That was
  unreachable while a committed seed file guaranteed sixteen rows across all four
  severities, because the only way to reach the empty branch was a severity that happened
  to have none. With the seed gone and the table empty, this is the default view of the
  section and the first sentence a visitor reads.
*/
const emptyLine =
  scope === 'all' ? 'Nothing here yet.' : `Nothing filed under ${scopeLabel} yet.`;

/*
  Only the default view is indexable. The other fourteen are the same stories in a
  different order, which is the textbook definition of duplicate content.
*/
const isDefault = scope === 'all' && sort === 'liked';
---

<Base
  title={title}
  active="dd"
  noindex={!isDefault}
  description="Real outages, real bad code, real 2am pages, told by the people who caused them."
>
  <main id="main" data-pagefind-ignore>
    <div class="shell">
      <header class="pagehead topichead">
        <span class="path">dev-disasters</span>
        <h1>
          Everybody has one.{' '}
          <span class="squiggle">
            <span>{counts.all > 0 ? `Here are ${counts.all} of them.` : 'Nobody has told me theirs yet.'}</span>
          </span>
        </h1>
        <p class="lede">
          Real outages, real bad code, real 2am pages, told by the people who caused them.
          Nobody gets named. Nobody gets dunked on. That's the whole deal.
        </p>
      </header>

      <nav class="filters" aria-label="Filter and sort">
        <span class="lbl">Severity</span>
        <a
          class={scope === 'all' ? 'chip on' : 'chip'}
          aria-current={scope === 'all' ? 'true' : undefined}
          href={viewUrl('all', sort)}
        >
          All <span class="n">{counts.all}</span>
        </a>
        {
          SEVERITIES.map((s) => (
            <a
              class={scope === s.id ? 'chip on' : 'chip'}
              aria-current={scope === s.id ? 'true' : undefined}
              href={viewUrl(s.id, sort)}
            >
              {s.label} <span class="n">{counts[s.id]}</span>
            </a>
          ))
        }
        <span class="push"></span>
        <span class="lbl">Sort</span>
        {
          visibleSorts.map((o) => (
            <a
              class={sort === o.id ? 'chip on' : 'chip'}
              aria-current={sort === o.id ? 'true' : undefined}
              href={viewUrl(scope, o.id)}
            >
              {o.label}
            </a>
          ))
        }
      </nav>

      {
        rows.length === 0 ? (
          <p class="notice">
            {emptyLine} That is either good news or a sign that
            people only write these down when it really hurt.
          </p>
        ) : (
          <div class="wall">
            {rows.map((d) => (
              <article class={`wq ${wqClass(d.severity)}`}>
                <span class="wq-lab">
                  <b>{disasterCode(d.id)}</b>
                  <span class={`sev ${sevClass(d.severity)}`}>{sevLabel(d.severity)}</span>
                  {d.likes > 0 && (
                    <span class="wq-stats">
                      <span class="st">
                        <i>&#9825;</i>
                        {d.likes.toLocaleString('en-US')}
                      </span>
                    </span>
                  )}
                </span>
                <p class="wq-line">
                  <a class="stretch" href={d.url}>
                    {d.line}
                  </a>
                </p>
                <span class="wq-f">
                  {d.title} &middot; told by{' '}
                  <Teller teller={d.teller} />
                </span>
              </article>
            ))}
          </div>
        )
      }

      <div class="below dd-foot">
        <div class="story-cta">
          {rows.length > 0 && <span class="fine">Showing all {rows.length}</span>}
        </div>

        <div class="rule major"><h2>Your turn</h2></div>
        <div class="drip">
          <div>
            <p class="promise">
              Somewhere in your git history is a commit you still think about
            </p>
            <p>
              Write it down. Badly, if you want. I'll fix the typos and I will never put
              your employer's name anywhere near it. Some of these turn into videos, and
              when one of yours does, you get asked first.
            </p>
          </div>
          <div>
            <a class="btn primary" href="/submit/">Tell me yours</a>
            <p class="fine">Post anonymously if you'd rather. No name is ever required.</p>
          </div>
        </div>

        <div class="rule major" id="drip"><h2>The .NET Drip</h2></div>
        <Drip uid="dd" />
      </div>
    </div>
  </main>
</Base>

<style>
  .dd-foot {
    padding-top: 2rem;
  }
  .dd-foot .rule.major {
    margin-top: 3.5rem;
  }
  .dd-foot .drip .fine {
    margin-top: 0.9rem;
  }
</style>
