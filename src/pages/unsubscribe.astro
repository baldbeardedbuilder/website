---
/*
  Unsubscribe is a capability URL, so it works without a session.

  A browser GET confirms before changing anything because security scanners prefetch links.
  RFC 8058 clients POST List-Unsubscribe=One-Click and are handled immediately. Valid and
  unknown tokens render the same result, so the route cannot be used as a token oracle.
*/
import Base from '../layouts/Base.astro';
import { serviceClient, supabaseWritable } from '../lib/supabase';

export const prerender = false;

const KINDS = ['story_published', 'story_featured', 'comment_reply', 'all'] as const;
const UUID_RE = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

const params = Astro.url.searchParams;
const token = params.get('token') ?? '';
const raw = params.get('kind') ?? 'all';
const kind = (KINDS as readonly string[]).includes(raw) ? raw : 'all';
const hasToken = UUID_RE.test(token);

let submitted = false;
let oneClick = false;
let unavailable = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  oneClick = form.get('List-Unsubscribe') === 'One-Click';
  submitted = oneClick || form.get('confirm') === '1';

  if (submitted && hasToken) {
    if (!supabaseWritable) {
      unavailable = true;
    } else {
      const { error } = await serviceClient().rpc('unsubscribe_by_token', {
        p_token: token,
        p_kind: kind
      });
      unavailable = Boolean(error);
    }
  }

  if (oneClick) {
    return new Response(unavailable ? 'retry' : 'ok', {
      status: unavailable ? 503 : 200,
      headers: {
        'content-type': 'text/plain',
        'cache-control': 'no-store',
        'referrer-policy': 'no-referrer'
      }
    });
  }
}

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const WHAT: Record<string, string> = {
  story_published: 'emails about your stories going up',
  story_featured: 'emails about your stories being featured',
  comment_reply: 'emails about direct replies to your comments',
  all: 'every kind of notification email from this site'
};
---

<Base title="Email settings" description="Turn off an email notification." noindex>
  <main id="main">
    <div class="shell narrow">
      {
        !hasToken && (
          <>
            <div class="rule"><h1>That link is missing something</h1></div>
            <p class="lede">
              An unsubscribe link carries a token that says which setting to change, and
              this one arrived without it.
            </p>
            <p>
              Nothing has changed. Open the link in the email again, or use the privacy page
              to ask me to stop the remaining account notifications.
            </p>
            <p><a class="btn" href="/privacy/#retired-accounts">Privacy and account data</a></p>
          </>
        )
      }

      {
        hasToken && !submitted && (
          <>
            <div class="rule"><h1>Turn this email off?</h1></div>
            <p class="lede">
              This stops {WHAT[kind]}. Your other notification settings stay as they are.
            </p>
            <form method="post" action={Astro.url.pathname + Astro.url.search}>
              <input type="hidden" name="confirm" value="1" />
              <p><button class="btn primary" type="submit">Turn it off</button></p>
            </form>
            <p class="fine">
              You can also ask me to stop every remaining account notification from the
              privacy page.
            </p>
          </>
        )
      }

      {
        hasToken && submitted && unavailable && (
          <>
            <div class="rule"><h1>That did not change</h1></div>
            <p class="lede">
              Email settings are unavailable right now. Try this link again in a moment.
            </p>
          </>
        )
      }

      {
        hasToken && submitted && !unavailable && (
          <>
            <div class="rule"><h1>That is switched off</h1></div>
            <p class="lede">You will not get {WHAT[kind]} any more.</p>
            <p>
              Nothing else changed. Your stored account data and stories are exactly where
              you left them.
            </p>
            <p><a class="btn" href="/privacy/#retired-accounts">Privacy and account data</a></p>
            <p class="fine">
              If you did not ask for this, somebody has your unsubscribe link. Sign in has
              been retired, so this setting cannot be turned back on from the site.
            </p>
          </>
        )
      }
    </div>
  </main>
</Base>
