---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="That page is not here." noindex={true}>
  <main id="main" class="not-found">
    <div class="not-found-code" aria-hidden="true">404</div>
    <img src="/images/type-stage/shrug.webp" alt="Michael Jolley shrugging" width="1600" height="1139" />
    <div class="not-found-copy">
      <span class="signal-label">Well, that did not compile.</span>
      <h1>This page wandered off.</h1>
      <p>The link may be old, the URL may have a typo, or I moved something and missed a redirect. Either way, there is plenty of useful stuff still here.</p>
      <div class="not-found-actions">
        <a class="button primary" href="/">Back home</a>
        <a class="button secondary" href="/search/">Search the site</a>
      </div>
      <nav aria-label="Helpful links">
        <a href="/articles/">Articles</a>
        <a href="/videos/">Videos</a>
        <a href="/topics/">Topics</a>
      </nav>
    </div>
  </main>
</Base>
