---
/*
  Your account.

  The only page on the site with a form that writes to the database and no island behind
  it. That is on purpose. Settings is where a person most needs to be sure the thing they
  clicked took effect, and a full page POST followed by a redirect is certain by
  construction in a way an optimistic fetch never is.

  Signed out, this is a sign in page rather than a 401, because "you need an account" and
  "here is the button" belong on the same screen.
*/
import Base from '../layouts/Base.astro';
import {
  readAccount,
  saveAccount,
  saveNotificationPrefs,
  deleteAccount,
  readOwnSubmissions,
  BIO_MAX,
  LINKS_MAX
} from '../lib/account';
import { clearSession } from '../lib/auth';
import { PROVIDERS, PROVIDER_LABELS, PROVIDER_NOTES, isProvider } from '../lib/providers';
import SubmissionList from '../components/SubmissionList.astro';
import { supabaseWritable } from '../lib/supabase';

export const prerender = false;

const profile = Astro.locals.profile;

let error: string | null = null;

if (Astro.request.method === 'POST' && profile) {
  const form = await Astro.request.formData();

  const intent = form.get('intent');

  if (intent === 'delete') {
    if (String(form.get('confirm') ?? '').trim().toLowerCase() !== profile.handle) {
      error = 'Type your handle exactly to confirm.';
    } else {
      const result = await deleteAccount(profile.id);
      if (result.ok) {
        clearSession(Astro);
        return Astro.redirect('/?goodbye=1', 303);
      }
      error = result.error ?? 'Could not delete the account.';
    }
  } else if (intent === 'notifications') {
    const result = await saveNotificationPrefs(profile.id, form);
    if (result.ok) return Astro.redirect('/account/?saved=notifications#email-notifications', 303);
    error = result.error ?? 'Could not save email settings.';
  } else {
    const result = await saveAccount(profile.id, form);
    if (result.ok) return Astro.redirect('/account/?saved=profile', 303);
    error = result.error ?? 'Could not save that.';
  }
}

const account = profile ? await readAccount(profile.id) : null;
const submissions = profile ? await readOwnSubmissions(profile.id) : [];
const saved = Astro.url.searchParams.get('saved');

/*
  How the linking round trip reports back. It leaves this page, hands off to a provider
  and comes back through /auth/callback/, so there is no request left to carry a result in
  and it arrives as a query parameter instead.

  Four outcomes rather than the two that were worth telling apart before. "cancelled" used
  to be the answer for every handshake that came back without a code, which meant somebody
  who pressed Approve on Discord and was refused by Supabase got told they had cancelled.
  Being told you did something you did not do is worse than being told nothing.

  "exists" is the one most people will actually meet, because a Discord account already
  attached to another account here is the ordinary way a link gets refused. "failed" keeps
  the rest, including manual linking being switched off in the Supabase project, which is a
  configuration mistake the reader cannot fix and should not be blamed for. The reason
  Supabase gave is in the server log in every case.
*/
const LINK_MESSAGES: Record<string, { ok: boolean; text: (who: string) => string }> = {
  ok: { ok: true, text: (who) => `${who} connected.` },
  cancelled: { ok: false, text: (who) => `Nothing was connected. You cancelled at ${who}.` },
  exists: {
    ok: false,
    text: (who) => `That ${who} account is already connected to an account here.`
  },
  failed: {
    ok: false,
    text: (who) => `${who} could not be connected, and nothing about your account changed.`
  },
  unknown: { ok: false, text: () => 'That is not a provider this site knows about.' }
};

const linkStatus = Astro.url.searchParams.get('link') ?? '';
const linkProvider = Astro.url.searchParams.get('provider') ?? '';
const linkMessage = LINK_MESSAGES[linkStatus] ?? null;
const linkResult = linkMessage
  ? {
      ok: linkMessage.ok,
      text: linkMessage.text(
        isProvider(linkProvider) ? PROVIDER_LABELS[linkProvider] : 'That account'
      )
    }
  : null;

const linkRows = Array.from({ length: LINKS_MAX }, (_, i) => account?.links[i] ?? { label: '', url: '' });
const linkLabelExamples = ['Website', 'GitHub', 'YouTube', 'Bluesky'];
const accountName = account ? account.displayName || account.handle : '';
const accountInitial = accountName.trim().charAt(0).toUpperCase() || '@';
const canEmail = Boolean(account?.email && account.preferences);
---

<Base title="Account settings" description="Settings for your Bald Bearded Builder account." noindex>
  <main id="main" class="account-page">
    <div class="shell account-shell">
      {!supabaseWritable && (
        <section class="account-gate setting-shell" aria-labelledby="account-unavailable">
          <div class="setting-card gate-card">
            <span class="path">account<span class="sep">/</span><b>offline</b></span>
            <h1 id="account-unavailable">Accounts are switched off here.</h1>
            <p class="lede">This environment cannot read or save account details.</p>
          </div>
        </section>
      )}

      {supabaseWritable && !account && (
        <section class="account-gate setting-shell" aria-labelledby="account-signin">
          <div class="setting-card gate-card">
            <span class="path">account<span class="sep">/</span><b>sign in</b></span>
            <h1 id="account-signin">Your seat is waiting.</h1>
            <p class="lede">
              Sign in to tell a story, shape your public profile, and keep the badges you
              have already earned in one place.
            </p>
            <div class="gate-actions">
              <a class="btn primary" href="/signin/?next=/account/" rel="nofollow">
                Sign in <span aria-hidden="true">&rarr;</span>
              </a>
              <p class="fine">
                Use GitHub, Discord, or Twitch. We read the basic profile details shared by
                the provider you choose. Nothing is written back.
              </p>
            </div>
          </div>
        </section>
      )}

      {account && (
        <>
          <header class="account-head">
            <div>
              <span class="path">account<span class="sep">/</span><b>{account.handle}</b></span>
              <h1>Your corner of the site.</h1>
              <p class="lede">
                Set the name people see, the links worth following, and how much of your
                activity belongs in public.
              </p>
            </div>
            <a class="profile-ticket" href={`/builders/${account.handle}/`}>
              <span class="profile-ticket-core">
                <span class="avatar" aria-hidden="true">{accountInitial}</span>
                <span>
                  <b>{accountName}</b>
                  <span>@{account.handle}</span>
                </span>
                <span class={`visibility ${account.isPrivate ? 'private' : 'public'}`}>
                  {account.isPrivate ? 'Private' : 'Public'}
                </span>
              </span>
              <span class="profile-ticket-foot">View profile <span aria-hidden="true">&rarr;</span></span>
            </a>
          </header>

          <div class="account-layout">
            <aside class="account-rail">
              <p class="eyebrow">Account map</p>
              <nav aria-label="Account sections">
                <a href="#public-details">Public details</a>
                <a href="#privacy">Privacy</a>
                <a href="#email-notifications">Email notifications</a>
                <a href="#stories">Your stories</a>
                <a href="#connections">Connections</a>
                <a href="#sign-out">Sign out</a>
                <a class="danger-link" href="#delete-account">Delete account</a>
              </nav>
              <p class="fine">
                Changes are saved with a full page refresh, so what you see afterward is
                what is stored.
              </p>
            </aside>

            <div class="account-content">
              {saved && (
                <p class="notice account-notice ok" role="status">
                  {saved === 'notifications' ? 'Email settings saved.' : 'Profile saved.'}
                </p>
              )}
              {error && <p class="notice account-notice bad" role="alert">{error}</p>}

              <form class="account-form form" method="post" action="/account/">
                <section class="setting-shell" id="public-details" aria-labelledby="public-details-title">
                  <div class="setting-card">
                    <header class="setting-head">
                      <div>
                        <p class="eyebrow">What people see</p>
                        <h2 id="public-details-title">Public details</h2>
                      </div>
                      <span class="section-mark" aria-hidden="true">@</span>
                    </header>

                    <div class="field">
                      <label for="handle">Handle <span class="required">required</span></label>
                      <p class="help" id="handle-help">
                        Your profile lives at /builders/{account.handle}/. Use lower case
                        letters, numbers and hyphens.
                      </p>
                      <input
                        id="handle"
                        name="handle"
                        type="text"
                        value={account.handle}
                        required
                        minlength="3"
                        maxlength="32"
                        pattern="[a-z0-9][a-z0-9\-]{1,30}[a-z0-9]"
                        autocomplete="username"
                        aria-describedby="handle-help"
                      />
                    </div>

                    <div class="field">
                      <label for="display_name">Display name</label>
                      <p class="help" id="display-name-help">The human-friendly name shown above your handle.</p>
                      <input
                        id="display_name"
                        name="display_name"
                        type="text"
                        maxlength="60"
                        value={account.displayName}
                        autocomplete="nickname"
                        aria-describedby="display-name-help"
                      />
                    </div>

                    <div class="field">
                      <label for="bio">Bio</label>
                      <p class="help" id="bio-help">A short introduction for your builder profile.</p>
                      <textarea id="bio" name="bio" rows="4" maxlength={BIO_MAX} aria-describedby="bio-help">{account.bio}</textarea>
                    </div>

                    <fieldset class="links-field">
                      <legend>Links</legend>
                      <p class="help" id="links-help">
                        Add up to {LINKS_MAX}. They are nofollowed, so they are for people
                        rather than search engines.
                      </p>
                      <div class="links-list">
                        {linkRows.map((l, i) => (
                          <div class="link-row">
                            <span class="link-number" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                            <div class="field compact">
                              <label for={`link_label_${i}`}>Label</label>
                              <input
                                id={`link_label_${i}`}
                                name={`link_label_${i}`}
                                type="text"
                                placeholder={linkLabelExamples[i] ?? 'Website'}
                                maxlength="40"
                                value={l.label}
                                aria-describedby="links-help"
                              />
                            </div>
                            <div class="field compact">
                              <label for={`link_url_${i}`}>Address</label>
                              <input
                                id={`link_url_${i}`}
                                name={`link_url_${i}`}
                                type="url"
                                inputmode="url"
                                placeholder="https://"
                                value={l.url}
                                aria-describedby="links-help"
                              />
                            </div>
                          </div>
                        ))}
                      </div>
                    </fieldset>
                  </div>
                </section>

                <section class="setting-shell" id="privacy" aria-labelledby="privacy-title">
                  <div class="setting-card">
                    <header class="setting-head">
                      <div>
                        <p class="eyebrow">Your boundary</p>
                        <h2 id="privacy-title">Privacy</h2>
                      </div>
                      <span class="section-mark" aria-hidden="true">/</span>
                    </header>

                    <div class="switch-row">
                      <input
                        class="switch"
                        id="is_private"
                        name="is_private"
                        type="checkbox"
                        checked={account.isPrivate}
                      />
                      <div>
                        <label class="switch-label" for="is_private">
                          Hide my profile. When hidden, your name comes off stories.
                        </label>
                        <span class="switch-help">
                          Your profile returns a 404 and your name comes off stories. The
                          content stays published. Turn this off and your name comes back.
                        </span>
                      </div>
                    </div>
                  </div>
                </section>

                <div class="save-bar">
                  <div>
                    <b>Ready when you are.</b>
                    <span>Public details and privacy save together.</span>
                  </div>
                  <button class="btn primary" type="submit">
                    Save profile <span aria-hidden="true">&rarr;</span>
                  </button>
                </div>
              </form>

              <section
                class="setting-shell email-settings"
                id="email-notifications"
                aria-labelledby="email-heading"
              >
                <div class="setting-card">
                  <header class="setting-head">
                    <div>
                      <p class="eyebrow">Your inbox</p>
                      <h2 id="email-heading">Email notifications</h2>
                    </div>
                    <span class="section-mark" aria-hidden="true">@</span>
                  </header>

                  {
                    canEmail ? (
                      <>
                        <p class="email-destination">
                          Sent to <code class="notification-address">{account.email}</code>.
                          This address comes from your auth provider and cannot be changed here.
                        </p>

                        <form
                          class="form notification-form"
                          method="post"
                          action="/account/#email-notifications"
                        >
                          <input type="hidden" name="intent" value="notifications" />
                          <fieldset class="notification-options">
                            <legend class="vh">Choose which email notifications to receive</legend>

                            <div class="switch-row">
                              <input
                                class="switch"
                                type="checkbox"
                                id="story_published"
                                name="story_published"
                                checked={account.preferences?.storyPublished}
                              />
                              <div>
                                <label class="switch-label" for="story_published">Story published</label>
                                <span class="switch-help">
                                  Hear when a dev disaster you sent is published, including one
                                  published without your name.
                                </span>
                              </div>
                            </div>

                            <div class="switch-row">
                              <input
                                class="switch"
                                type="checkbox"
                                id="story_featured"
                                name="story_featured"
                                checked={account.preferences?.storyFeatured}
                              />
                              <div>
                                <label class="switch-label" for="story_featured">Story featured</label>
                                <span class="switch-help">
                                  Hear when one of your stories reaches the front page.
                                </span>
                              </div>
                            </div>

                          </fieldset>

                          <div class="save-bar email-save">
                            <span>These settings do not affect the separate .NET Drip newsletter.</span>
                            <button class="btn primary" type="submit">
                              Save email settings <span aria-hidden="true">&rarr;</span>
                            </button>
                          </div>
                        </form>
                      </>
                    ) : (
                      <p class="notice">
                        Your auth provider has not supplied a deliverable email address. No
                        notification can be sent, so these controls are unavailable.
                      </p>
                    )
                  }
                </div>
              </section>

              <section class="setting-shell" id="stories" aria-label="Your stories">
                <div class="setting-card stories-card">
                  <SubmissionList submissions={submissions} />
                </div>
              </section>

              <section class="setting-shell" id="connections" aria-labelledby="connections-title">
                <div class="setting-card">
                  <header class="setting-head">
                    <div>
                      <p class="eyebrow">Where you came from</p>
                      <h2 id="connections-title">Connected accounts</h2>
                    </div>
                    <span class="section-mark" aria-hidden="true">+</span>
                  </header>

                  <p class="help connections-help">
                    Connect as many as you like. They all lead to this one account, and
                    each one brings whatever only it can tell us.
                  </p>

                  {linkResult && (
                    <p class={`notice account-notice ${linkResult.ok ? 'ok' : 'bad'}`} role="status">
                      {linkResult.text}
                    </p>
                  )}

                  <ul class="connection-list">
                    {PROVIDERS.map((provider) => {
                      /*
                        Attached is one question and what to call it is another. A provider
                        can be connected and still have no name to show: Discord will hand
                        over an identity and no username the site can read, and answering
                        that with "Not connected" next to a "Link it" that can only fail is
                        how this list spent its time calling people liars.
                      */
                      const connection = account.connections[provider];

                      return (
                        <li>
                          <span class="connection-name">
                            <b>{PROVIDER_LABELS[provider]}</b>
                            <span>{PROVIDER_NOTES[provider]}</span>
                          </span>
                          {connection.connected ? (
                            <span class="connection-state connected">
                              {connection.login ? `@${connection.login}` : 'Connected'}
                            </span>
                          ) : (
                            <span class="connection-state">
                              Not connected{' '}
                              <a href={`/auth/link/${provider}/`} rel="nofollow">
                                Link it<span class="vh"> ({PROVIDER_LABELS[provider]})</span>
                              </a>
                            </span>
                          )}
                        </li>
                      );
                    })}
                  </ul>
                </div>
              </section>

              <section class="setting-shell" id="sign-out" aria-labelledby="sign-out-title">
                <div class="setting-card">
                  <header class="setting-head">
                    <div>
                      <p class="eyebrow">This browser</p>
                      <h2 id="sign-out-title">Sign out</h2>
                    </div>
                    <span class="section-mark" aria-hidden="true">&rarr;</span>
                  </header>

                  <div class="signout-row">
                    {/*
                      A POST, and a real form rather than a link. A GET sign out means any
                      image tag on any page can sign a reader out, and a form works with
                      JavaScript switched off, which the rest of the site promises anyway.
                    */}
                    <form method="post" action="/auth/signout/">
                      <input type="hidden" name="next" value="/" />
                      <button class="btn" type="submit">
                        Sign out <span aria-hidden="true">&rarr;</span>
                      </button>
                    </form>
                    <p class="fine">
                      Ends the session in this browser only. Anywhere else you are signed
                      in stays signed in, and nothing here is deleted.
                    </p>
                  </div>
                </div>
              </section>

              <section class="setting-shell danger-shell" id="delete-account" aria-labelledby="delete-account-title">
                <div class="setting-card">
                  <header class="setting-head">
                    <div>
                      <p class="eyebrow">Permanent action</p>
                      <h2 id="delete-account-title">Delete your account</h2>
                    </div>
                    <span class="section-mark" aria-hidden="true">!</span>
                  </header>
                  <p class="danger-copy">
                    This removes your account, handle, badges and Twitch link. Published
                    stories stay published without your name.
                  </p>
                  <form class="delete-form form" method="post" action="/account/">
                    <input type="hidden" name="intent" value="delete" />
                    <div class="field">
                      <label for="confirm">Type <b>{account.handle}</b> to confirm</label>
                      <input id="confirm" name="confirm" type="text" autocomplete="off" required />
                    </div>
                    <div class="danger-actions">
                      <button class="btn danger" type="submit">Delete my account</button>
                      <span class="fine">There is no undo.</span>
                    </div>
                  </form>
                </div>
              </section>
            </div>
          </div>
        </>
      )}
    </div>
  </main>
</Base>

<style>
  .account-page {
    padding: clamp(3.5rem, 8vw, 7rem) 0 7rem;
  }

  .account-shell {
    max-width: 72rem;
  }

  .account-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(17rem, 21rem);
    gap: clamp(2rem, 7vw, 6rem);
    align-items: end;
    padding-bottom: 3rem;
    border-bottom: 1px solid var(--line);
  }

  .account-head h1,
  .gate-card h1 {
    max-width: 12ch;
    margin: 0.8rem 0 1rem;
    font-size: clamp(2.75rem, 7vw, 5.8rem);
    line-height: 0.94;
  }

  .profile-ticket,
  .setting-shell {
    display: block;
    padding: 0.35rem;
    border: 1px solid var(--line);
    border-radius: calc(var(--r) + 4px);
    background: color-mix(in srgb, var(--bg-raised) 68%, var(--bg));
  }

  .profile-ticket {
    color: var(--fg);
    text-decoration: none;
    transition:
      border-color 220ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .profile-ticket:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }

  .profile-ticket-core {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: 0.85rem;
    align-items: center;
    padding: 1rem;
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--bg-raised);
  }

  .avatar {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    border: 1px solid var(--accent);
    border-radius: 50%;
    color: var(--accent);
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 700;
  }

  .profile-ticket-core b,
  .profile-ticket-core span span {
    display: block;
  }

  .profile-ticket-core > span:nth-child(2) {
    min-width: 0;
  }

  .profile-ticket-core > span:nth-child(2) b {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .profile-ticket-core > span:nth-child(2) span,
  .profile-ticket-foot {
    color: var(--fg-dim);
    font-family: var(--mono);
    font-size: 0.6875rem;
  }

  .visibility {
    padding: 0.2rem 0.4rem;
    border: 1px solid currentColor;
    border-radius: 2px;
    color: var(--accent);
    font-family: var(--mono);
    font-size: 0.625rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .visibility.private {
    color: var(--fg-dim);
  }

  .profile-ticket-foot {
    display: flex;
    justify-content: space-between;
    padding: 0.65rem 0.65rem 0.3rem;
  }

  .account-layout {
    display: grid;
    grid-template-columns: 11.5rem minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: start;
    padding-top: 3rem;
  }

  .account-rail {
    position: sticky;
    top: 6.75rem;
  }

  .account-rail nav {
    display: grid;
    margin: 1rem 0 1.5rem;
    border-top: 1px solid var(--line);
  }

  .account-rail nav a {
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line);
    color: var(--fg-dim);
    font-family: var(--mono);
    font-size: 0.75rem;
    text-decoration: none;
    transition: color 180ms cubic-bezier(0.16, 1, 0.3, 1);
  }

  .account-rail nav a:hover {
    color: var(--accent);
  }

  .account-rail nav .danger-link:hover {
    color: var(--sev-error);
  }

  .account-rail .fine {
    display: block;
    line-height: 1.65;
  }

  .account-content,
  .account-form {
    display: grid;
    gap: 1.5rem;
    min-width: 0;
  }

  .setting-shell {
    scroll-margin-top: 7rem;
  }

  .setting-card {
    padding: clamp(1.4rem, 4vw, 2.4rem);
    border: 1px solid var(--line);
    border-radius: var(--r);
    background: var(--bg);
  }

  .setting-head {
    display: flex;
    gap: 1.5rem;
    align-items: start;
    justify-content: space-between;
    margin-bottom: 2rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--line);
  }

  .setting-head h2 {
    margin-top: 0.35rem;
    font-size: clamp(1.75rem, 4vw, 2.4rem);
  }

  .section-mark {
    color: var(--accent);
    font-family: var(--mono);
    font-size: 1.25rem;
  }

  .required {
    color: var(--fg-dim);
    font-weight: 400;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .links-field {
    display: grid;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .links-field legend {
    margin-bottom: 0.5rem;
    color: var(--fg);
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .links-field > .help {
    max-width: 40rem;
    margin: 0 0 0.75rem;
    color: var(--fg-dim);
    font-size: 0.9375rem;
  }

  .links-list {
    display: grid;
    border-top: 1px solid var(--line);
  }

  .link-row {
    display: grid;
    grid-template-columns: 2rem minmax(7rem, 0.7fr) minmax(12rem, 1.3fr);
    gap: 0.85rem;
