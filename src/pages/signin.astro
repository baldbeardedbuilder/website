---
/*
  Pick a way in.

  /auth/signin/ is a redirect, not a page, so there was nowhere for anybody to choose.
  This is that somewhere. Every button is a plain link, which means this works with no
  JavaScript and survives being bookmarked, and `next` rides along so the reader lands
  back where they were rather than on the front page.

  `next` is checked here as well as in the route it points at. It is rendered into three
  hrefs on this page, and a page that echoes an unchecked path into a link is a page that
  writes phishing links for you.
*/
import Base from '../layouts/Base.astro';
import { supabaseWritable } from '../lib/supabase';
import { safeReturnPath } from '../lib/auth';
import { PROVIDERS, PROVIDER_LABELS } from '../lib/providers';

export const prerender = false;

const next = safeReturnPath(Astro.url.searchParams.get('next'));

/*
  A sign in that broke on the way out or on the way back comes here rather than to the
  front page, because this is the only page with the buttons to try it again on. Without
  the notice, arriving back at the chooser having pressed a button and approved at the
  provider reads as the button doing nothing.
*/
const failed = Astro.url.searchParams.get('auth') === 'failed';

/* Already signed in and following an old link. Send them on rather than asking again. */
if (Astro.locals.profile) {
  return Astro.redirect(next, 302);
}

const href = (provider: string) =>
  `/auth/signin/?provider=${provider}&next=${encodeURIComponent(next)}`;

Astro.response.headers.set('Cache-Control', 'no-store');
---

<Base title="Sign in" description="Sign in with GitHub, Discord, or Twitch." noindex>
  <main id="main">
    <div class="shell narrow">
      <div class="rule"><h1>Pick a way in.</h1></div>

      {
        !supabaseWritable && (
          <p class="lede">
            Sign in is unavailable right now. Nothing is wrong with your account. Try again
            in a few minutes.
          </p>
        )
      }

      {
        supabaseWritable && (
          <>
            {failed && (
              <p class="notice signin-notice" role="status">
                That did not finish, and you are not signed in. Nothing about your account
                changed. Try again, or pick a different way in.
              </p>
            )}

            <p class="lede">
              Three doors, one account. Use whichever you already have, and if you use more
              than one they land on the same profile as long as they share an email address.
            </p>

            <ul class="signin-options">
              {PROVIDERS.map((provider) => (
                <li>
                  <a class="btn primary signin-option" href={href(provider)} rel="nofollow">
                    Continue with {PROVIDER_LABELS[provider]}
                    <span aria-hidden="true">&rarr;</span>
                  </a>
                </li>
              ))}
            </ul>

            <p class="fine">
              We read the basic profile details shared by the provider you choose, and the
              email address so account notifications have somewhere to go. Nothing is written
              back, and none of this can read a repository, join a server, or touch a stream.
            </p>
            <p class="fine">
              Signing in means you are good with the <a href="/terms/">terms</a>, the{' '}
              <a href="/privacy/">privacy notice</a>, and the <a href="/conduct/">code of conduct</a>.
            </p>
          </>
        )
      }
    </div>
  </main>
</Base>

<style>
  .signin-notice {
    margin: 1.25rem 0 0;
    max-width: 26rem;
  }

  .signin-options {
    list-style: none;
    margin: 1.5rem 0;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    max-width: 26rem;
  }

  .signin-option {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    width: 100%;
  }
</style>
