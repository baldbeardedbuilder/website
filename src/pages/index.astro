---
import Base from '../layouts/Base.astro';
import Drip from '../components/Drip.astro';
import FeedItem from '../components/FeedItem.astro';
import { SITE, VISIBLE_TOPICS } from '../config/site';
import { allItems, isVideoKind, itemKindLabel, itemsInTopic, type Item } from '../lib/content';
import { starterItems } from '../lib/starters';

const items = await allItems();
const hero = items[0];
const starters = await starterItems();
const starterVideo = starters.find((item) => isVideoKind(item.kind));
const starterArticle = starters.find((item) => item.kind === 'article');

const mostWatched = items
  .filter((item) => isVideoKind(item.kind) && item.views !== null)
  .sort((left, right) => (right.views ?? 0) - (left.views ?? 0))
  .slice(0, 5);

const articles = items.filter((item) => item.kind === 'article');
const worthReading = [...starters.filter((item) => item.kind === 'article'), ...articles]
  .filter((item, index, all) => all.findIndex((candidate) => candidate.key === item.key) === index)
  .slice(0, 4);

const topicCounts = await Promise.all(
  VISIBLE_TOPICS.map(async (topic) => ({
    topic,
    count: (await itemsInTopic(topic.slug)).length
  }))
);

const latest = items.slice(0, 6);
const opensYouTube = (item: Item) => isVideoKind(item.kind) && item.offsite;
---

<Base title={SITE.name} description={SITE.tagline}>
  <main id="main">
    <section class="hero">
      <div class="hero-type" aria-hidden="true"><span>BUILD</span><span>BETTER</span></div>
      <div class="hero-copy">
        <span class="signal-label">Real code. Honest tradeoffs.</span>
        <h1>Have some fun doing it.</h1>
        <p>.NET, Windows, developer tools, and mistakes included.</p>
        <a href="#start">Find your starting point <span aria-hidden="true">&darr;</span></a>
      </div>
      <img
        class="hero-person"
        src="/images/type-stage/point.webp"
        alt="Michael Jolley pointing toward the latest lesson"
        width="1600"
        height="1139"
        fetchpriority="high"
      />
      {hero && (
        <a
          class="hero-latest"
          href={hero.href}
          target={opensYouTube(hero) ? '_blank' : undefined}
          rel={hero.offsite ? 'noopener noreferrer' : undefined}
        >
          <span>Newest thing / {itemKindLabel(hero.kind)} / {hero.topic}</span>
          <strong>{hero.title}</strong>
          <div><i>{hero.length}</i><b>{isVideoKind(hero.kind) ? 'Watch now' : 'Read now'} &rarr;</b></div>
        </a>
      )}
      <div class="hero-foot">
        <span>Michael Jolley</span>
        <span>Writing C# since 1999</span>
        <span>Learning out loud</span>
      </div>
    </section>

    <section id="start" class="start-here">
      <header class="section-header">
        <span>New here?</span>
        <h2>Start with these.</h2>
        <p>One video and one article. They show how I teach, what I care about, and why the answer is usually "it depends."</p>
      </header>
      <div class="start-grid">
        {starterVideo && (
          <a
            class="start-watch"
            href={starterVideo.href}
            target={opensYouTube(starterVideo) ? '_blank' : undefined}
            rel={starterVideo.offsite ? 'noopener noreferrer' : undefined}
          >
            {starterVideo.thumbnail && <img src={starterVideo.thumbnail} alt="" width="1280" height="720" />}
            <div class="start-overlay">
              <span>Watch this first / {starterVideo.length}</span>
              <h3>{starterVideo.title}</h3>
              {starterVideo.description && <p>{starterVideo.description}</p>}
              <strong>Play the video &rarr;</strong>
            </div>
          </a>
        )}
        {starterArticle && (
          <a class="start-read" href={starterArticle.href}>
            <span>Read this first / {starterArticle.length}</span>
            <div class="config-lines" aria-hidden="true">
              <i>Build the smallest useful thing</i>
              <i>Measure what matters</i>
              <i class="bad">Question the happy path</i>
            </div>
            <h3>{starterArticle.title}</h3>
            {starterArticle.description && <p>{starterArticle.description}</p>}
            <strong>Read the article &rarr;</strong>
          </a>
        )}
      </div>
    </section>

    {mostWatched.length > 0 && (
      <section class="most-watched">
        <header class="section-header light">
          <span>The numbers have spoken</span>
          <h2>Most watched.</h2>
          <p>What developers have watched most across the channel, ranked by real YouTube views.</p>
        </header>
        <div class="watch-grid">
          <a
            class="watch-lead"
            href={mostWatched[0].href}
            target="_blank"
            rel="noopener noreferrer"
          >
            {mostWatched[0].thumbnail && <img src={mostWatched[0].thumbnail} alt="" width="1280" height="720" />}
            <span class="rank">01</span>
            <div>
              <span>{mostWatched[0].views?.toLocaleString('en-US')} views / {mostWatched[0].length}</span>
              <h3>{mostWatched[0].title}</h3>
              <strong>Watch &rarr;</strong>
            </div>
          </a>
          <ol class="watch-list" start="2">
            {mostWatched.slice(1).map((item, index) => (
              <li>
                <a href={item.href} target="_blank" rel="noopener noreferrer">
                  <span class="number">{String(index + 2).padStart(2, '0')}</span>
                  {item.thumbnail && <img src={item.thumbnail} alt="" width="160" height="90" loading="lazy" />}
                  <div><h3>{item.title}</h3><span>{item.views?.toLocaleString('en-US')} views / {item.length}</span></div>
                  <b aria-hidden="true">&rarr;</b>
                </a>
              </li>
            ))}
          </ol>
        </div>
        <a class="section-link light-link" href="/videos/">Every video <span>&rarr;</span></a>
      </section>
    )}

    {worthReading.length > 0 && (
      <section class="most-read">
        <header class="section-header">
          <span>Keep these close</span>
          <h2>Worth reading.</h2>
          <p>Practical guides I would hand you when the same problem shows up again.</p>
        </header>
        <div class="reading-grid">
          {worthReading.map((item) => (
            <a href={item.href}>
              <span>{item.topic} / {item.length}</span>
              <h3>{item.title}</h3>
              {item.description && <p>{item.description}</p>}
              <strong>Read it &rarr;</strong>
            </a>
          ))}
        </div>
        <a class="section-link" href="/articles/">Every article <span>&rarr;</span></a>
      </section>
    )}

    <section class="topics">
      <header class="section-header light">
        <span>Pick your problem</span>
        <h2>Choose a rabbit hole.</h2>
        <p>Start with the thing you need to fix, understand, or finally stop searching for.</p>
      </header>
      <div class="topic-list">
        {topicCounts.filter(({ count }) => count > 0).map(({ topic, count }, index) => (
          <a href={`/${topic.slug}/`}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{topic.title}</strong>
            <i>{topic.blurb}</i>
            <b>{count} <span class="vh">pieces</span> &rarr;</b>
          </a>
        ))}
      </div>
    </section>

    <section class="latest-feed">
      <header class="section-header">
        <span>Straight off the workbench</span>
        <h2>Latest.</h2>
        <p>Videos and articles together, newest first.</p>
      </header>
      <div class="feed homepage-feed">
        {latest.map((item) => <FeedItem item={item} />)}
      </div>
      <a class="section-link" href="/all/">Everything I've made <span>&rarr;</span></a>
    </section>

    <section class="about-stage home-about">
      <div class="page-ghost" aria-hidden="true">MICHAEL.</div>
      <div class="about-stage-inner">
        <div>
          <span class="signal-label">The bald one</span>
          <h2>I teach the way I learned: out loud.</h2>
          <p>I have spent more than twenty years building software with C# and .NET. You will see the code, the setup, the tradeoffs, and the part that did not work the first time.</p>
          <a class="text-link" href="/about/">More about me &rarr;</a>
        </div>
        <img src="/images/type-stage/think.webp" alt="Michael Jolley thinking with his hand on his beard" width="1600" height="1139" loading="lazy" />
      </div>
    </section>

    <Drip uid="home" />
  </main>
</Base>
