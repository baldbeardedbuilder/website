---
import Base from '../layouts/Base.astro';
import Drip from '../components/Drip.astro';
import FeedItem from '../components/FeedItem.astro';
import PageHero from '../components/PageHero.astro';
import { allItems, isVideoKind } from '../lib/content';

const videos = (await allItems()).filter((item) => isVideoKind(item.kind));
const long = videos.filter((video) => video.kind === 'video');
const shorts = videos.filter((video) => video.kind === 'short');
const featured = videos[0];

function byYear(items: typeof videos) {
  const groups = new Map<number, typeof videos>();
  for (const item of items) {
    const year = item.date.getUTCFullYear();
    groups.set(year, [...(groups.get(year) ?? []), item]);
  }
  return [...groups.entries()].sort((left, right) => right[0] - left[0]);
}
---

<Base title="Videos" description="Every video I have made, long form and shorts, newest first." active="videos">
  <main id="main" class="subpage">
    <PageHero
      ghost="WATCH."
      title="Build it with me."
      accent="Pauses included."
      description="Real code, the occasional wrong turn, and enough context to know when the shiny pattern is the wrong one."
      stats={[
        { label: 'Long form', value: `${long.length} builds + lessons` },
        { label: 'Short form', value: `${shorts.length} quick answers` }
      ]}
    />
    <section class="archive">
      <header class="archive-head">
        <h2>Everything I have filmed.</h2>
        <p>Long builds and short answers live together here, but not mixed willy nilly.</p>
      </header>
      {featured && (
        <a
          class="archive-feature"
          href={featured.href}
          target={featured.offsite ? '_blank' : undefined}
          rel={featured.offsite ? 'noopener noreferrer' : undefined}
        >
          <div class="feature-visual">
            {featured.thumbnail && <img src={featured.thumbnail} alt="" width="1280" height="720" />}
          </div>
          <div class="feature-copy">
            <span>Newest / {featured.topic} / {featured.length}</span>
            <h2>{featured.title}</h2>
            {featured.description && <p>{featured.description}</p>}
            <strong>Watch the video &rarr;</strong>
          </div>
        </a>
      )}
      {long.length > 0 && (
        <>
          <div class="year-divider"><h2>Long form</h2><span>Newest first</span></div>
          {byYear(long.filter((item) => item !== featured)).map(([year, rows]) => (
            <section class="archive-year">
              <h3>{year}</h3>
              <div class="archive-list">{rows.map((item) => <FeedItem item={item} level={4} />)}</div>
            </section>
          ))}
        </>
      )}
      {shorts.length > 0 && (
        <>
          <div class="year-divider"><h2>Shorts</h2><span>Small answers, fast</span></div>
          {byYear(shorts.filter((item) => item !== featured)).map(([year, rows]) => (
            <section class="archive-year">
              <h3>{year}</h3>
              <div class="archive-list">{rows.map((item) => <FeedItem item={item} level={4} />)}</div>
            </section>
          ))}
        </>
      )}
    </section>
    <Drip uid="videos" />
  </main>
</Base>
