---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';

const active = (await getCollection('gear')).filter((item) => item.data.status === 'active');
const categoryOrder = ['Hardware', 'Software', 'Network', 'Audio', 'Video'];
const grouped = new Map<string, typeof active>();

for (const item of active) {
  grouped.set(item.data.category, [...(grouped.get(item.data.category) ?? []), item]);
}
for (const items of grouped.values()) {
  items.sort((left, right) => left.data.rank - right.data.rank);
}

const categories = [...grouped.keys()].sort((left, right) => {
  const leftIndex = categoryOrder.indexOf(left);
  const rightIndex = categoryOrder.indexOf(right);
  if (leftIndex === -1 && rightIndex === -1) return left.localeCompare(right);
  if (leftIndex === -1) return 1;
  if (rightIndex === -1) return -1;
  return leftIndex - rightIndex;
});
---

<Base title="Uses" description="The hardware, software, and services Michael Jolley uses to build and teach." active="uses">
  <main id="main" class="subpage">
    <PageHero
      ghost="TOOLS."
      title="The gear"
      accent="that earns its spot."
      description="This is what I use to write code, make videos, and keep the whole operation moving. Some links are affiliate links. The opinion is still mine."
      stats={[{ label: 'Listed here', value: `${active.length} tools` }]}
    />
    <section class="uses-directory">
      {categories.map((category, index) => (
        <section class="uses-group" id={category.toLowerCase()}>
          <header>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h2>{category}</h2>
            <i>{grouped.get(category)!.length} {grouped.get(category)!.length === 1 ? 'thing' : 'things'}</i>
          </header>
          <div class="uses-list">
            {grouped.get(category)!.map((item) => (
              <article class="use-row">
                <div>
                  <h3>{item.data.title}</h3>
                  {item.data.description && <p>{item.data.description}</p>}
                </div>
                {item.data.link && (
                  <a href={item.data.link} target="_blank" rel="nofollow noopener noreferrer">
                    Visit site <span aria-hidden="true">&nearr;</span>
                  </a>
                )}
              </article>
            ))}
          </div>
        </section>
      ))}
      <p class="affiliate-note">If you buy through an affiliate link, I may earn a commission at no extra cost to you. Nobody paid for a place on this list.</p>
    </section>
  </main>
</Base>
