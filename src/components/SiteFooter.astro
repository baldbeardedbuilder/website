---
import Mark from './Mark.astro';
import { SITE, EXTERNAL } from '../config/site';
---

<footer class="site-footer">
  <div class="footer-brand">
    <Mark />
    <div>
      <strong>{SITE.name}</strong>
      <p>{SITE.tagline}</p>
    </div>
  </div>
  <nav aria-label="Footer navigation">
    <a href="/videos/">Videos</a>
    <a href="/articles/">Articles</a>
    <a href="/topics/">Topics</a>
    <a href="/about/">About</a>
    <a href="/uses/">Uses</a>
    <a href="/search/">Search</a>
    <a href="/account/">Account</a>
    <a href="/conduct/">Conduct</a>
    <a href="/privacy/">Privacy</a>
    <a href="/terms/">Terms</a>
    <a target="_blank" rel="noopener" href={EXTERNAL.youtube}>YouTube</a>
    <a target="_blank" rel="noopener" href={EXTERNAL.github}>GitHub</a>
    <a target="_blank" rel="noopener" href={EXTERNAL.drip}>The .NET Drip</a>
  </nav>
  <div class="footer-fine">
    <span>&copy; {new Date().getUTCFullYear()} Michael Jolley</span>
    <span>Built in public. Mistakes included.</span>
  </div>
</footer>
