---
/*
  The byline on a dev disaster, in one place.

  Three surfaces draw this: the wall, the front page lead and the story page. They were
  three copies of the same ternary, which is how the privacy rule came to be applied in a
  query and not in a byline. One component means the next change to what a byline may say
  happens once.

  Nothing is drawn for a teller that did not resolve. That is damage rather than a choice,
  and "anonymous" would state something false about somebody who never chose it.
*/
import type { Teller } from '../lib/disasters';

interface Props {
  teller: Teller;
}

const { teller } = Astro.props;
---

{
  teller.shown === 'handle' ? (
    teller.handle
  ) : teller.shown === 'anonymous' ? (
    'anonymous'
  ) : null
}
