---
/*
  The .NET Drip signup.

  Signup data is posted as JSON to the existing Hookdeck webhook. The endpoint must be
  configured for the form to accept submissions.

  Deliberately no issue count and no subscriber count. The archive in the content
  submodule holds the recent run, not the whole history, so any number built from it
  understates the real one and reads as a smaller newsletter than this is. A count that
  is only right at a particular scale does not belong in a build that ships at zero.

  The input id has to be unique per page because more than one Drip block can appear on
  the same document, and two labels pointing at the same id makes the second one lie.
*/
import { EXTERNAL } from '../config/site';

interface Props {
  /** Distinguishes this block's input from any other Drip block on the same page. */
  uid: string;
}

const { uid } = Astro.props;
const inputId = `drip-${uid}`;
const hookdeckWebhookUrl = import.meta.env.PUBLIC_HOOKDECK_WEBHOOK_URL ?? '';
---

<section class="drip" aria-labelledby={`drip-title-${uid}`}>
  <div class="drip-word" aria-hidden="true">DRIP.</div>
  <div class="drip-copy">
    <span>The .NET Drip</span>
    <h2 id={`drip-title-${uid}`}>A little .NET in your inbox.</h2>
    <p>One useful tip, a few links worth your time, and the occasional war story. No inbox flood.</p>
  </div>
  <form
    class="drip-form"
    method="POST"
    action="/?subscribed=true#drip"
    data-hookdeck-webhook={hookdeckWebhookUrl}
  >
    <input type="hidden" name="utm_source" value="baldbeardedbuilder" />
    <p class="skip">
      <label>Leave this empty if you are a person <input name="bot-field" tabindex="-1" /></label>
    </p>
    <label for={inputId}>Email address</label>
    <div class="drip-input-row">
      <input id={inputId} name="email" type="email" required placeholder="developer@example.com" />
      <button type="submit">Get The Drip</button>
    </div>
    <p class="form-message">Free to join. Unsubscribe whenever.</p>
    <p class="form-message drip-status" role="status" aria-live="polite"></p>
    <p class="drip-archive"><a href={EXTERNAL.drip}>Read the archive.</a></p>
  </form>
</section>

<script>
  import { submitNewsletterSignup } from '../lib/newsletter';

  document.querySelectorAll<HTMLFormElement>('.drip-form').forEach((form) => {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      const status = form.querySelector<HTMLElement>('.drip-status');
      const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const data = new FormData(form);
      const email = data.get('email');
      const source = data.get('utm_source');
      const honeypot = data.get('bot-field');

      if (typeof honeypot === 'string' && honeypot.trim()) return;
      if (typeof email !== 'string' || typeof source !== 'string') return;

      if (!form.dataset.hookdeckWebhook) {
        if (status) status.textContent = 'Signup is temporarily unavailable. Please try again later.';
        return;
      }

      if (button) button.disabled = true;
      if (status) status.textContent = 'Submitting…';

      try {
        await submitNewsletterSignup(form.dataset.hookdeckWebhook ?? '', {
          email,
          utm_source: source
        });
        window.location.assign('/?subscribed=true#drip');
      } catch {
        if (status) {
          status.textContent = 'We could not submit your signup. Please try again.';
        }
        if (button) button.disabled = false;
      }
    });
  });
</script>
