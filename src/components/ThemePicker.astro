---
import { THEMES, THEME_STORAGE_KEY } from '../lib/themes.generated';

/*
  The theme picker is not an island.

  It appears in the masthead of every single page, and a Preact island put roughly 19 KB
  of framework on all of them for what is, in the end, a disclosure button that sets one
  attribute. Preact still earns its place on the like controls, but not here. This version
  ships the whole menu as HTML and wires it up with about a kilobyte of inline script.
*/

const SWATCH_VARS = ['--bg', '--accent', '--sev-error', '--sev-warn', '--sev-info'];
const SCHEMES = [
  ['dark', 'Dark'],
  ['light', 'Light']
] as const;
---

{/*
  With no JavaScript the button cannot do anything, and a control that does nothing is
  worse than no control. themes.css still honours prefers-color-scheme, so those readers
  get the right one of the two house themes regardless.
*/}
<noscript><style>.themer { display: none; }</style></noscript>

<div class="themer" data-themer data-storage-key={THEME_STORAGE_KEY}>
  <button class="themer-btn" type="button" aria-expanded="false" aria-controls="themer-menu">
    {/*
      The swatch carries its own data-theme, which is what lets a single element preview a
      theme the page is not currently using. themes.css scopes every token to [data-theme]
      rather than to :root, so the var() lookups inside resolve against the preview.
    */}
    <span class="swatch" data-theme={THEMES[0].id} data-current-swatch>
      {SWATCH_VARS.map((v) => <i style={`background:var(${v})`} />)}
    </span>
    <span class="themer-label">{THEMES[0].name}</span>
    <span class="caret" aria-hidden="true">&#9662;</span>
  </button>

  {/*
    Disclosure, not a menu. A theme switcher is a set of controls rather than a set of
    commands, and role="menu" would forbid the Dark and Light group labels the design
    calls for.
  */}
  <div class="themer-menu" id="themer-menu" hidden>
    {
      SCHEMES.map(([scheme, label]) => (
        <div class="themer-group" role="group" aria-labelledby={`themer-group-${scheme}`}>
          <p class="themer-group-label" id={`themer-group-${scheme}`}>
            {label}
          </p>
          {THEMES.filter((t) => t.scheme === scheme)
            .sort((a, b) => a.name.localeCompare(b.name))
            .map((t) => (
              <button type="button" data-theme-id={t.id} aria-current="false">
                <span class="swatch" data-theme={t.id}>
                  {SWATCH_VARS.map((v) => (
                    <i style={`background:var(${v})`} />
                  ))}
                </span>
                <span>{t.name}</span>
              </button>
            ))}
        </div>
      ))
    }
  </div>
</div>

<script is:inline>
  (() => {
    const host = document.querySelector('[data-themer]');
    if (!host) return;
    const key = host.dataset.storageKey;
    const trigger = host.querySelector('.themer-btn');
    const menu = host.querySelector('.themer-menu');
    const label = host.querySelector('.themer-label');
    const swatch = host.querySelector('[data-current-swatch]');
    const options = [...host.querySelectorAll('[data-theme-id]')];

    /* The no FOUC script in the head has already chosen and applied a theme, so this
       adopts what is on the document rather than deciding for a second time. */
    const sync = () => {
      const id = document.documentElement.getAttribute('data-theme');
      for (const opt of options) {
        const on = opt.dataset.themeId === id;
        opt.setAttribute('aria-current', on ? 'true' : 'false');
        if (on) {
          swatch.setAttribute('data-theme', id);
          label.textContent = opt.querySelector('span:last-child').textContent;
        }
      }
    };

    const setOpen = (open) => {
      menu.hidden = !open;
      trigger.setAttribute('aria-expanded', open ? 'true' : 'false');
    };

    trigger.addEventListener('click', () => setOpen(menu.hidden));

    for (const opt of options) {
      opt.addEventListener('click', () => {
        const id = opt.dataset.themeId;
        document.documentElement.setAttribute('data-theme', id);
        try {
          localStorage.setItem(key, id);
        } catch {
          /* private mode, the choice just does not persist */
        }
        sync();
        setOpen(false);
        trigger.focus();
      });
    }

    document.addEventListener(
      'click',
      (e) => {
        if (!menu.hidden && !host.contains(e.target)) setOpen(false);
      },
      true
    );

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !menu.hidden) {
        setOpen(false);
        trigger.focus();
      }
    });

    sync();
  })();
</script>
